# Port d'écoute du serveur web
PORT=3000

# Secret pour la signature des tokens JWT
JWT_SECRET=votre_clef_secrete_tres_longue_et_aleatoire_a_changer

# Base de données Turso
# Pour le développement local rapide sans Turso distant, laissez "file:local.db"
# En production sur Turso : libsql://votre-base-nom.turso.io
TURSO_DATABASE_URL=file:local.db

# Jeton d'authentification Turso (laisser vide si utilisation locale de file:local.db)
TURSO_AUTH_TOKEN=
